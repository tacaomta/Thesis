\@writefile{lof}{\contentsline {figure}{\numberline {2.3}{\ignorespaces The subroutine \textit  {MIFS}$(v_0, W, k)$, where $v_0$ is the target variable, $W = \{w_1, w_2, \ldots  , w_M\}$ is the set of variables, and $k$ is the desired number of input variables.}}{19}{figure.caption.32}\protected@file@percent }
\newlabel{fig:chapter2_mifs}{{2.3}{19}{The subroutine \textit {MIFS}$(v_0, W, k)$, where $v_0$ is the target variable, $W = \{w_1, w_2, \ldots , w_M\}$ is the set of variables, and $k$ is the desired number of input variables}{figure.caption.32}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.4}{\ignorespaces The subroutine \textit  {SWAP}$(v_0, S, W)$, where $v_0$ is the target variable; $S = \{s_1, s_2, \ldots  , s_k\}$ is the set of selected variables such that $I(v_0, s_i) \geq I(v_0, s_j)$ if $i < j$ for all $s_i, s_j \in S$; and $W = \{w_1, w_2, \ldots  , w_M\}$ is the set of unselected variables such that $I(v_0, w_i) \geq I(v_0, w_j)$ if $i < j$ for all $w_i, w_j \in W$.}}{20}{figure.caption.33}\protected@file@percent }
\newlabel{fig:chapter2_swap}{{2.4}{20}{The subroutine \textit {SWAP}$(v_0, S, W)$, where $v_0$ is the target variable; $S = \{s_1, s_2, \ldots , s_k\}$ is the set of selected variables such that $I(v_0, s_i) \geq I(v_0, s_j)$ if $i < j$ for all $s_i, s_j \in S$; and $W = \{w_1, w_2, \ldots , w_M\}$ is the set of unselected variables such that $I(v_0, w_i) \geq I(v_0, w_j)$ if $i < j$ for all $w_i, w_j \in W$}{figure.caption.33}{}}
\newlabel{fig:chapter2_case1_dynamics_performance}{{2.5}{21}{}{figure.caption.38}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.6}{\ignorespaces Inference performance according to the number of incoming links (\textit  {D}) in the gold-standard network.}}{22}{figure.caption.39}\protected@file@percent }
\newlabel{fig:chapter2_case1_incoming_links}{{2.6}{22}{Inference performance according to the number of incoming links (\textit {D}) in the gold-standard network}{figure.caption.39}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.7}{\ignorespaces The proportion of three-level discretized genes in the networks.}}{23}{figure.caption.40}\protected@file@percent }
\newlabel{fig:chapter2_propotion}{{2.7}{23}{The proportion of three-level discretized genes in the networks}{figure.caption.40}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.8}{\ignorespaces Structural performance on random real-valued networks. Four network size groups ($|V| = 50, 100, 200, 300$) were examined, with 20 randomly generated networks for each size. Target genes were categorized based on the number of incoming regulatory links ($D$) in the gold-standard network. The x-axis represents the values of $D$, while the y-axis indicates the average structural accuracy across networks.}}{24}{figure.caption.41}\protected@file@percent }
\newlabel{fig:chapter2_structure_accuracy}{{2.8}{24}{Structural performance on random real-valued networks. Four network size groups ($|V| = 50, 100, 200, 300$) were examined, with 20 randomly generated networks for each size. Target genes were categorized based on the number of incoming regulatory links ($D$) in the gold-standard network. The x-axis represents the values of $D$, while the y-axis indicates the average structural accuracy across networks}{figure.caption.41}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.9}{\ignorespaces Dynamical performance on the random real-valued networks. Four size groups of networks ($|V| = 50, 100, 200, \text  { and } 300$) were considered, and 20 random networks were generated for each group. All target genes are grouped according to the number of incoming links ($D$) in the gold-standard network, and the x-axis represents the $D$ values. The y-axis shows the average dynamics accuracy.}}{25}{figure.caption.42}\protected@file@percent }
\newlabel{fig:chapter2_dynamic_accuracy}{{2.9}{25}{Dynamical performance on the random real-valued networks. Four size groups of networks ($|V| = 50, 100, 200, \text { and } 300$) were considered, and 20 random networks were generated for each group. All target genes are grouped according to the number of incoming links ($D$) in the gold-standard network, and the x-axis represents the $D$ values. The y-axis shows the average dynamics accuracy}{figure.caption.42}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.10}{\ignorespaces Comparison of running time across different network sizes. The x-axis represents the network size, while the y-axis shows the running time in milliseconds on a $\log _{10}$ scale.}}{26}{figure.caption.43}\protected@file@percent }
\newlabel{fig:chapter2_running_time}{{2.10}{26}{Comparison of running time across different network sizes. The x-axis represents the network size, while the y-axis shows the running time in milliseconds on a $\log _{10}$ scale}{figure.caption.43}{}}
