\@writefile{toc}{\contentsline {subsection}{\numberline {4.5.2}Results of Structural Performance}{56}{subsection.102}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.2}{\ignorespaces Results of precision, recall, and structural accuracy on the multi-level discretization dataset. (\textbf  {a}--\textbf  {c}). Results for the network with \(|V|=50\). (\textbf  {d}--\textbf  {f}).Results for the network with \(|V|=100\). The Y-axis denotes the performance metrics, and the X-axis indicates the number of observed time steps in the original gene expression data. For the synthesized dataset, gene expression data are generated for \((100-K)\) time steps. Solid and dashed lines represent the results based on the synthesized and the original dataset, respectively. Each point and error bar indicates the average value and the standard deviation, respectively, over 10 random networks. The bar charts show the performance improvement of the synthesized dataset over the original dataset.}}{57}{figure.caption.100}\protected@file@percent }
\newlabel{chapter4_triple_performance}{{4.2}{57}{Results of precision, recall, and structural accuracy on the multi-level discretization dataset. (\textbf {a}--\textbf {c}). Results for the network with \(|V|=50\). (\textbf {d}--\textbf {f}).Results for the network with \(|V|=100\). The Y-axis denotes the performance metrics, and the X-axis indicates the number of observed time steps in the original gene expression data. For the synthesized dataset, gene expression data are generated for \((100-K)\) time steps. Solid and dashed lines represent the results based on the synthesized and the original dataset, respectively. Each point and error bar indicates the average value and the standard deviation, respectively, over 10 random networks. The bar charts show the performance improvement of the synthesized dataset over the original dataset}{figure.caption.100}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.3}{\ignorespaces Results of precision, recall, and structural accuracy on the Boolean discretization dataset. (\textbf  {a}--\textbf  {c}) Results for the network with \(|V|=50\). (\textbf  {d}--\textbf  {f}) Results for the network with \(|V|=100\). The Y-axis denotes the performance metrics, and the X-axis indicates the number of observed time steps in the original gene expression data. For the synthesized dataset, gene expression data are generated for \((100-K)\) time steps. Solid and dashed lines represent the results based on the synthesized and the original dataset, respectively. Each point and error bar indicates the average value and the standard deviation, respectively, over 10 random networks. The bar charts show the performance improvement of the synthesized dataset over the original dataset.}}{58}{figure.caption.101}\protected@file@percent }
\newlabel{fig:chapter4_bool_performance}{{4.3}{58}{Results of precision, recall, and structural accuracy on the Boolean discretization dataset. (\textbf {a}--\textbf {c}) Results for the network with \(|V|=50\). (\textbf {d}--\textbf {f}) Results for the network with \(|V|=100\). The Y-axis denotes the performance metrics, and the X-axis indicates the number of observed time steps in the original gene expression data. For the synthesized dataset, gene expression data are generated for \((100-K)\) time steps. Solid and dashed lines represent the results based on the synthesized and the original dataset, respectively. Each point and error bar indicates the average value and the standard deviation, respectively, over 10 random networks. The bar charts show the performance improvement of the synthesized dataset over the original dataset}{figure.caption.101}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.5.3}Results of Dynamic Accuracy}{58}{subsection.103}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.4}{\ignorespaces Comparison results of dynamic accuracy on the multi-level discretization dataset. (\textbf  {a}) Networks of \(|V|=50\). (\textbf  {b}) Networks of \(|V|=100\). The Y-axis denotes the dynamic accuracy, and the X-axis indicates the number of observed time steps. The dashed and solid lines represent the results of the networks inferred from the original and the synthetic expression data, respectively.}}{59}{figure.caption.104}\protected@file@percent }
\newlabel{dynamic_triple}{{4.4}{59}{Comparison results of dynamic accuracy on the multi-level discretization dataset. (\textbf {a}) Networks of \(|V|=50\). (\textbf {b}) Networks of \(|V|=100\). The Y-axis denotes the dynamic accuracy, and the X-axis indicates the number of observed time steps. The dashed and solid lines represent the results of the networks inferred from the original and the synthetic expression data, respectively}{figure.caption.104}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.5.4}Results of Similarity of Synthesized Expressions}{59}{subsection.106}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.5}{\ignorespaces Comparison results of the dynamic accuracy on the Boolean discretization dataset. (\textbf  {a})~Networks of \(|V|=50\). (\textbf  {b}) Networks of \(|V|=100\). The Y-axis denotes the dynamic accuracy, and the X-axis indicates the number of observed time steps. The dashed and solid lines represent the results of the networks inferred from the original and the synthetic expression data, respectively.}}{60}{figure.caption.105}\protected@file@percent }
\newlabel{dynamic_bool}{{4.5}{60}{Comparison results of the dynamic accuracy on the Boolean discretization dataset. (\textbf {a})~Networks of \(|V|=50\). (\textbf {b}) Networks of \(|V|=100\). The Y-axis denotes the dynamic accuracy, and the X-axis indicates the number of observed time steps. The dashed and solid lines represent the results of the networks inferred from the original and the synthetic expression data, respectively}{figure.caption.105}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4.6}Discussion and Conclusions}{60}{section.108}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.6}{\ignorespaces Similarity matrix between the synthesized gene expression data. (\textbf  {a}) An example of a similarity matrix between a pair of synthesized gene expression data values when \(K\) equals 10. The white or black dot indicates that the corresponding gene values between two expression data values are identical or not, respectively. (\textbf  {b}) Change in the mean similarity index against the time step number (\(K\)). For each \(K\) from 10 to 90, three pairs of synthesized gene expression data values were used to compute the mean similarity index. The Y-axis denotes the similarity index, defined as the rate of the number of identical dots over the total number of dots in the gene expression matrix. The X-axis corresponds to the number of observed time steps \(K\). }}{61}{figure.caption.107}\protected@file@percent }
\newlabel{distance}{{4.6}{61}{Similarity matrix between the synthesized gene expression data. (\textbf {a}) An example of a similarity matrix between a pair of synthesized gene expression data values when \(K\) equals 10. The white or black dot indicates that the corresponding gene values between two expression data values are identical or not, respectively. (\textbf {b}) Change in the mean similarity index against the time step number (\(K\)). For each \(K\) from 10 to 90, three pairs of synthesized gene expression data values were used to compute the mean similarity index. The Y-axis denotes the similarity index, defined as the rate of the number of identical dots over the total number of dots in the gene expression matrix. The X-axis corresponds to the number of observed time steps \(K\)}{figure.caption.107}{}}
