{
  "name": "thesis-presentation",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "slidev",
    "build:main": "slidev build slides.md --out dist/y2026 --base=/Thesis/y2026/",
    "build:share": "slidev build slides_share.md --out dist/share --base=/Thesis/share/ --without-notes",
    "build": "npm run build:main && npm run build:share"
  },
  "dependencies": {
    "@slidev/cli": "^52.19.1",
    "@slidev/theme-default": "latest",
    "@slidev/theme-seriph": "latest",
    "echarts": "^6.1.0",
    "vue": "^3.5.33"
  }
}